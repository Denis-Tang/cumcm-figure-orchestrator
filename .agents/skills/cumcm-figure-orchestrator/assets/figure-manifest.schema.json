{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/cumcm-figure-manifest.schema.json",
  "title": "CUMCM Figure Manifest",
  "type": "object",
  "required": [
    "batch_id",
    "competition_profile",
    "paper",
    "figures"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "competition_profile": {
      "const": "cumcm"
    },
    "paper": {
      "type": "object",
      "required": [
        "title",
        "source_path"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "schema_version": {
      "const": 2
    },
    "delivery_status": {
      "enum": [
        "planned",
        "partial",
        "ready",
        "no_figures"
      ]
    },
    "target_figure_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "page_width_mm",
        "margin_left_mm",
        "margin_right_mm",
        "min_dpi"
      ],
      "properties": {
        "page_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin_left_mm": {
          "type": "number",
          "minimum": 25
        },
        "margin_right_mm": {
          "type": "number",
          "minimum": 25
        },
        "min_dpi": {
          "type": "number",
          "minimum": 300
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "status",
        "method"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_applicable",
            "pending"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "details": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    },
    "figure": {
      "type": "object",
      "required": [
        "figure_id",
        "status",
        "task_type",
        "claim",
        "caption",
        "paper_anchor",
        "sources",
        "constraints"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "status": {
          "enum": [
            "formal",
            "alternative",
            "draft",
            "excluded"
          ]
        },
        "task_type": {
          "enum": [
            "data_chart",
            "flowchart",
            "network",
            "map",
            "conceptual_schematic",
            "composite"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "paper_anchor": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "chart_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_width_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "constraints": {
          "type": "object",
          "required": [
            "exact_numeric",
            "exact_text",
            "vector_required",
            "reproducible_required"
          ],
          "properties": {
            "exact_numeric": {
              "type": "boolean"
            },
            "exact_text": {
              "type": "boolean"
            },
            "vector_required": {
              "type": "boolean"
            },
            "reproducible_required": {
              "type": "boolean"
            },
            "contains_text": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "route": {
          "type": "object",
          "required": [
            "provider",
            "score",
            "alternatives",
            "reasons"
          ],
          "properties": {
            "skill": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "renderer": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "properties": {
            "png": {
              "type": [
                "string",
                "null"
              ]
            },
            "svg": {
              "type": [
                "string",
                "null"
              ]
            },
            "pdf": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "renderer_version": {
              "type": "string"
            },
            "ai_assisted": {
              "type": "boolean"
            },
            "ai_tool_and_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "ai_output_adopted": {
              "enum": [
                "none",
                "partial",
                "full",
                null
              ]
            },
            "human_edits": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification_method": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "qa": {
          "type": "object",
          "properties": {
            "numeric_check": {
              "$ref": "#/$defs/check"
            },
            "ocr_check": {
              "$ref": "#/$defs/check"
            },
            "collision_check": {
              "$ref": "#/$defs/check"
            },
            "clipping_check": {
              "$ref": "#/$defs/check"
            },
            "grayscale_check": {
              "$ref": "#/$defs/check"
            },
            "export_check": {
              "$ref": "#/$defs/check"
            },
            "claim_caption_check": {
              "$ref": "#/$defs/check"
            },
            "visual_review": {
              "$ref": "#/$defs/check"
            },
            "structure_check": {
              "$ref": "#/$defs/check"
            },
            "panel_size_uniformity": {
              "$ref": "#/$defs/check"
            },
            "text_solid_stroke_clearance": {
              "$ref": "#/$defs/check"
            },
            "legend_data_region_clearance": {
              "$ref": "#/$defs/check"
            },
            "axes_frame_closed": {
              "$ref": "#/$defs/check"
            },
            "panel_aspect_whitelist": {
              "$ref": "#/$defs/check"
            },
            "curve_smoothing": {
              "$ref": "#/$defs/check"
            }
          },
          "additionalProperties": false
        },
        "pipeline_state": {
          "enum": [
            "planned",
            "rendered",
            "verified",
            "blocked"
          ]
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "semantic_contract": {
          "type": "object",
          "required": [
            "source_mapping",
            "invariants"
          ],
          "properties": {
            "source_mapping": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "invariants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "data_contract": {
          "$ref": "#/$defs/data_contract"
        },
        "style_policy": {
          "type": "object",
          "required": [
            "profile_id",
            "baseline_id",
            "input_files"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "baseline_id": {
              "type": "string",
              "minLength": 1
            },
            "input_files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "object_mapping": {
              "type": "object"
            },
            "panel_groups": {
              "type": "object"
            },
            "layout_justifications": {
              "type": "object"
            },
            "frame_exemptions": {
              "type": "object"
            },
            "tick_side_justifications": {
              "type": "object"
            },
            "continuity_declarations": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "enum": [
                      "continuous",
                      "discrete",
                      "step",
                      "piecewise_linear"
                    ]
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "continuous",
                          "discrete",
                          "step",
                          "piecewise_linear"
                        ]
                      },
                      "y_range": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "x_range": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "turning_points": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sample_count": {
                        "type": "integer",
                        "minimum": 2
                      }
                    }
                  }
                ]
              }
            },
            "overrides": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "data_chart",
                  "map"
                ]
              }
            },
            "required": [
              "task_type"
            ]
          },
          "then": {
            "properties": {
              "data_contract": {
                "required": [
                  "reference_data",
                  "plotted_data",
                  "verification_code",
                  "numeric_columns",
                  "atol",
                  "rtol",
                  "tolerance_reason"
                ]
              }
            }
          }
        }
      ]
    },
    "data_contract": {
      "type": "object",
      "required": [
        "input_files",
        "fields",
        "observation_unit",
        "keys",
        "time_scope",
        "missing_policy",
        "duplicate_policy",
        "transformations",
        "verification_method"
      ],
      "properties": {
        "input_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "unit",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "observation_unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "time_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "missing_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "duplicate_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "reference_data": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "plotted_data": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "numeric_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        },
        "tolerance_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "object",
          "required": [
            "parameters",
            "seed",
            "solver_status",
            "reproduction_status"
          ],
          "properties": {
            "parameters": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "solver_status": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reproduction_status": {
              "enum": [
                "reproduced",
                "supplied_only",
                "blocked"
              ]
            }
          }
        }
      }
    }
  }
}
